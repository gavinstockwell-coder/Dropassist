{
  "manifest_version": 3,
  "name": "DropBuddy",
  "version": "1.7.1",
  "description": "Personal Supreme drop helper: watchlist, synced countdown, monitor, add to cart, saved shipping + encrypted card autofill, resale value check. You click the final pay button.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DropBuddy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://us.supreme.com/*",
    "https://supreme.com/*",
    "https://checkout.pci.shopifyinc.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://us.supreme.com/*"
      ],
      "js": [
        "lib/ns.js",
        "lib/time.js",
        "lib/match.js",
        "lib/fill.js",
        "lib/ui.js",
        "config/supreme.js",
        "adapters/supreme.js",
        "content/runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://checkout.pci.shopifyinc.com/*"
      ],
      "js": [
        "lib/ns.js",
        "lib/fill.js",
        "content/cardframe.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://api.stockx.com/*",
    "https://accounts.stockx.com/*",
    "https://api.ebay.com/*",
    "https://discord.com/*",
    "https://discordapp.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/fonts/*.woff2"
      ],
      "matches": [
        "https://us.supreme.com/*"
      ]
    }
  ]
}
